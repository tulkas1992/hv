---
import Social from "../ui/Social.astro";
import { Icon } from "astro-icon/components";
import { SITE } from "../../config/site";

const { name, email, whatsapp, github, linkedin, instagram, youtube, jobTitle, city } = SITE;
const year = new Date().getFullYear();

const links = [
  { name: "Inicio", path: "/#home" },
  { name: "Experiencia", path: "/#experience" },
  { name: "Proyectos", path: "/#projects" },
  { name: "Sobre mí", path: "/about-me" },
];
---

<footer
  class="relative mt-10 w-full border-t border-black/5 px-6 pt-14 pb-8 text-blacktext dark:border-white/10 dark:text-zinc-300"
  role="contentinfo"
  aria-label="Pie de página"
>
  <div
    class="pointer-events-none absolute inset-x-0 top-0 mx-auto h-px max-w-3xl bg-gradient-to-r from-transparent via-mint-400 to-transparent"
    aria-hidden="true"
  ></div>

  <div class="mx-auto grid max-w-7xl gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
    <div class="flex flex-col gap-4">
      <a href="/" aria-label="Volver al inicio" class="group flex w-fit items-center gap-3">
        <Icon name="logo" class="size-10 transition-transform group-hover:rotate-6" aria-hidden="true" />
        <span class="text-xl font-black tracking-tight text-blacktext dark:text-white">
          Victor <span class="bg-gradient-to-r from-mint-500 to-riptide-500 bg-clip-text text-transparent dark:from-mint-300 dark:to-riptide-300">Ruiz Reyes</span>
        </span>
      </a>
      <p class="max-w-sm text-sm leading-6 text-zinc-600 dark:text-zinc-400">
        {jobTitle} en {city}. Creo y administro sitios y aplicaciones web rápidos, accesibles y pensados para crecer.
      </p>
      <span class="inline-flex w-fit items-center gap-2 rounded-full border border-mint-500/30 bg-mint-500/10 px-3 py-1 text-xs font-semibold text-mint-700 dark:text-mint-200">
        <span class="size-2 animate-pulse rounded-full bg-green-400" aria-hidden="true"></span>
        Disponible para nuevos proyectos
      </span>
    </div>

    <nav aria-label="Navegación del pie de página">
      <h2 class="mb-4 text-xs font-bold uppercase tracking-widest text-zinc-500 dark:text-zinc-400">Navegación</h2>
      <ul class="flex flex-col gap-2 text-sm">
        {links.map((link) => (
          <li>
            <a href={link.path} class="transition-colors hover:text-mint-500 dark:hover:text-mint-300">{link.name}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div>
      <h2 class="mb-4 text-xs font-bold uppercase tracking-widest text-zinc-500 dark:text-zinc-400">Contacto</h2>
      <ul class="flex flex-col gap-2 text-sm">
        <li>
          <a href={`mailto:${email}`} class="inline-flex items-center gap-2 transition-colors hover:text-mint-500 dark:hover:text-mint-300">
            <Icon name="envelope" aria-hidden="true" /> {email}
          </a>
        </li>
        <li>
          <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 transition-colors hover:text-mint-500 dark:hover:text-mint-300">
            <Icon name="whatsapp" aria-hidden="true" /> WhatsApp
          </a>
        </li>
      </ul>
      <div class="mt-5 flex items-center gap-4 text-xl" role="list" aria-label="Redes sociales">
        <Social link={github} iconName="github" label={`${name} en GitHub`} />
        {linkedin && <Social link={linkedin} iconName="linkedin" label={`${name} en LinkedIn`} />}
        {instagram && <Social link={instagram} iconName="instagram" label={`${name} en Instagram`} />}
        {youtube && <Social link={youtube} iconName="youtube" label={`${name} en YouTube`} />}
      </div>
    </div>
  </div>

  <div class="mx-auto mt-12 flex max-w-7xl flex-wrap items-center justify-between gap-4 border-t border-black/5 pt-6 text-xs text-zinc-500 dark:border-white/10 dark:text-zinc-400">
    <p>© {year} {name}. Hecho con Astro y Tailwind CSS.</p>
    <a href="#home" class="inline-flex items-center gap-1 font-semibold transition-colors hover:text-mint-500 dark:hover:text-mint-300">
      Volver arriba <span aria-hidden="true">↑</span>
    </a>
  </div>
</footer>
