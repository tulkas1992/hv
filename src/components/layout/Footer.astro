---
import Social from "../ui/Social.astro";
import { Icon } from "astro-icon/components";

import { SITE } from "../../config/site";

const { name, email, github, linkedin, instagram, youtube } = SITE;
---

<footer
  class="relative bottom-0 w-full px-4 py-8 font-medium text-blacktext dark:bg-transparent dark:border-b-2 dark:border-zinc-800 dark:text-zinc-300 max-lg:mt-3"
  role="contentinfo"
  aria-label="Pie de página"
>
  <nav
    class="mx-auto flex max-w-7xl flex-row items-center justify-between gap-4 text-xl max-xl:px-6 max-sm:flex-col"
    aria-label="Navegación del pie de página"
  >
    <div
      class="relative h-6 cursor-pointer before:absolute before:left-1/2 before:top-1/2 before:h-full before:w-[40%] before:-translate-x-1/2 before:-translate-y-1/2 before:rounded-full before:bg-[#8b5cf625] before:blur-3xl before:opacity-80 before:-z-1 hover:text-mint-500 transition-all [text-shadow:_0_1px_2px_#000]"
    >
      <a href="/" aria-label="Volver al inicio">
        <!-- This icon represents the logo -->
        <Icon name="logo" aria-hidden="true" />
      </a>
    </div>
    <div class="text-center">
      <a
        href={github}
        class="flex items-center justify-center gap-3 text-base font-normal italic max-sm:text-sm"
        aria-label="Sobre el desarrollo de este sitio"
        ><Icon name="code" aria-hidden="true" /> Desarrollado por <strong>{name}</strong>, con Astro</a
      >
    </div>
    <div class="flex items-center justify-center gap-5" role="list" aria-label="Redes sociales">
      <Social link={`mailto:${email}`} iconName="envelope" label={`Escribir un correo a ${email}`} />
      {instagram && <Social link={instagram} iconName="instagram" label={`${name} en Instagram`} />}
      {youtube && <Social link={youtube} iconName="youtube" label={`${name} en YouTube`} />}
      <Social link={github} iconName="github" label={`${name} en GitHub`} />
      {linkedin && <Social link={linkedin} iconName="linkedin" label={`${name} en LinkedIn`} />}
    </div>
  </nav>
</footer>
