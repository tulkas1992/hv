---
// Columnas de capturas de proyectos que se desplazan en bucle y se desvanecen
// con un degradado transparente en los bordes del contenedor.
interface Props {
  columns?: number;
  perColumn?: number;
  class?: string;
}

const { columns = 3, perColumn = 6, class: className = "" } = Astro.props;

const projects = await Astro.glob("../../pages/portfolio/projects/*.md");
projects.sort((a, b) => (a.frontmatter.order ?? 999) - (b.frontmatter.order ?? 999));

const images: string[] = projects
  .map((p) => p.frontmatter.image?.url)
  .filter((url): url is string => Boolean(url) && url !== "#")
  .slice(0, columns * perColumn);

// Reparte las imágenes en columnas intercaladas para que cada una mezcle proyectos distintos
const cols = Array.from({ length: columns }, (_, c) => images.filter((_, i) => i % columns === c));

// Duración y dirección distintas por columna para que el movimiento no se vea sincronizado
const durations = [38, 46, 42, 50];
---

<div class:list={["projects-marquee", className]} aria-hidden="true">
  <div class="projects-marquee__grid" style={`grid-template-columns: repeat(${columns}, minmax(0, 1fr))`}>
    {
      cols.map((col, c) => (
        <div class="projects-marquee__col">
          <div
            class:list={["projects-marquee__track", { "is-reverse": c % 2 === 1 }]}
            style={`--duration:${durations[c % durations.length]}s`}
          >
            {[...col, ...col].map((src, i) => (
              <img
                src={src}
                alt=""
                width="960"
                height="600"
                loading="eager"
                fetchpriority="low"
                decoding="async"
                class="projects-marquee__img"
              />
            ))}
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .projects-marquee {
    position: relative;
    overflow: hidden;
    /* Desvanecido transparente en los cuatro bordes: la máscara vertical y la horizontal
       se intersectan, así las imágenes aparecen y se disuelven suavemente en el contenedor */
    --fade-v: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(0, 0, 0, 0.06) 7%,
      rgba(0, 0, 0, 0.18) 16%,
      rgba(0, 0, 0, 0.36) 24%,
      rgba(0, 0, 0, 0.58) 34%,
      rgba(0, 0, 0, 0.8) 43%,
      #000 50%,
      rgba(0, 0, 0, 0.8) 57%,
      rgba(0, 0, 0, 0.58) 66%,
      rgba(0, 0, 0, 0.36) 76%,
      rgba(0, 0, 0, 0.18) 84%,
      rgba(0, 0, 0, 0.06) 93%,
      transparent 100%
    );
    --fade-h: linear-gradient(
      to right,
      transparent 0%,
      rgba(0, 0, 0, 0.35) 10%,
      rgba(0, 0, 0, 0.8) 22%,
      #000 31%,
      #000 69%,
      rgba(0, 0, 0, 0.8) 78%,
      rgba(0, 0, 0, 0.35) 90%,
      transparent 100%
    );
    -webkit-mask-image: var(--fade-v), var(--fade-h);
    -webkit-mask-composite: source-in;
    mask-image: var(--fade-v), var(--fade-h);
    mask-composite: intersect;
  }

  .projects-marquee__grid {
    position: absolute;
    inset: -20% -12%;
    display: grid;
    gap: 0.9rem;
    transform: rotate(-8deg) scale(1.05);
    transition: transform 0.6s ease;
  }

  :global(.group:hover) .projects-marquee__grid {
    transform: rotate(-6deg) scale(1.1);
  }

  .projects-marquee__col {
    overflow: hidden;
  }

  .projects-marquee__track {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    animation: projects-marquee-up var(--duration, 40s) linear infinite;
    will-change: transform;
  }

  .projects-marquee__track.is-reverse {
    animation-name: projects-marquee-down;
  }

  :global(.group:hover) .projects-marquee__track {
    animation-play-state: paused;
  }

  .projects-marquee__img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    border-radius: 0.75rem;
    box-shadow: 0 10px 30px -12px rgba(30, 27, 75, 0.55);
    outline: 1px solid rgba(255, 255, 255, 0.08);
    opacity: 0.82;
    filter: saturate(0.9);
    transition: opacity 0.5s ease, filter 0.5s ease;
  }

  :global(.group:hover) .projects-marquee__img {
    opacity: 1;
    filter: saturate(1.05);
  }

  /* El track contiene la lista duplicada: moverlo la mitad de su alto hace un bucle sin saltos */
  @keyframes projects-marquee-up {
    from { transform: translateY(0); }
    to { transform: translateY(calc(-50% - 0.45rem)); }
  }

  @keyframes projects-marquee-down {
    from { transform: translateY(calc(-50% - 0.45rem)); }
    to { transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .projects-marquee__track {
      animation: none;
    }
  }
</style>
