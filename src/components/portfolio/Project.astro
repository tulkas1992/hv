---
const { title, url, image, languages = [], description, category } = Astro.props;

import Capsule from "../ui/Capsule.astro";
---

<a
  href={url}
  class="group flex h-full flex-col overflow-hidden rounded-2xl border border-black/5 bg-white transition-all duration-300 ease-in-out hover:-translate-y-1 hover:border-mint-400/60 hover:shadow-[0_20px_40px_-20px_rgba(99,_102,_241,_0.45)] dark:border-white/10 dark:bg-zinc-900/60 dark:hover:border-mint-400/60"
>
  <div class="relative aspect-[16/10] overflow-hidden bg-zinc-100 dark:bg-zinc-800">
    <img
      class="h-full w-full object-cover object-top transition-transform duration-500 ease-in-out group-hover:scale-105"
      src={image.url}
      alt={image.alt}
      loading="lazy"
      width="960"
      height="600"
    />
    {
      category && (
        <span class="absolute left-3 top-3 rounded-full bg-white/90 px-3 py-1 text-xs font-bold text-mint-700 backdrop-blur dark:bg-zinc-950/80 dark:text-mint-200">
          {category}
        </span>
      )
    }
  </div>

  <article class="flex flex-1 flex-col gap-3 p-5">
    <h3 class="flex items-center justify-between gap-2 text-xl font-bold text-blacktext dark:text-white">
      {title}
      <span
        class="text-mint-500 opacity-0 transition-all group-hover:translate-x-1 group-hover:opacity-100"
        aria-hidden="true">→</span
      >
    </h3>

    <p class="line-clamp-2 text-sm leading-6 text-zinc-600 dark:text-zinc-300">
      {description}
    </p>

    <div class="mt-auto flex flex-wrap gap-2 pt-2">
      {
        languages.map((language: string) => (
          <Capsule size="xs" lang={language} />
        ))
      }
    </div>
  </article>
</a>
