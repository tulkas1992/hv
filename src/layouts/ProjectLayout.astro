---
import Layout from "./Layout.astro";
import Capsule from "../components/ui/Capsule.astro";
import Heading from "../components/ui/Heading.astro";
import NavArticle from "../components/layout/NavArticle.astro";
import { SITE, absoluteUrl } from "../config/site";
import { getLanguage } from "../utils/languages";
const { frontmatter } = Astro.props;

const slug = Astro.url.pathname.replace(/\/$/, "").split("/").pop();
const pagePath = `/portfolio/projects/${slug}/`;
const pageTitle = `${frontmatter.title}: proyecto web de ${SITE.name}`;
const techs = frontmatter.languages.map((l: string) => getLanguage(l).name).join(", ");
const fullDescription = `${frontmatter.description} Tecnologías: ${techs}.`;
// Google corta las descripciones a ~160 caracteres: se omite la lista de tecnologías si no cabe
const description = fullDescription.length <= 160 ? fullDescription : frontmatter.description;

const project = {
  "@type": "CreativeWork",
  "@id": `${absoluteUrl(pagePath)}#project`,
  name: frontmatter.title,
  description: frontmatter.description,
  url: frontmatter.url ?? absoluteUrl(pagePath),
  image: absoluteUrl(frontmatter.image.url),
  genre: frontmatter.category,
  keywords: frontmatter.languages.map((l: string) => getLanguage(l).name).join(", "),
  inLanguage: SITE.lang,
  creator: { "@id": `${SITE.url}/#person` },
};
---


<Layout
  pageTitle={pageTitle}
  description={description}
  ogimage={frontmatter.image}
  type="article"
  breadcrumbs={[
    { name: "Proyectos", path: "/#projects" },
    { name: frontmatter.title, path: pagePath },
  ]}
  schema={[project]}
>
  <section
    class="relative mx-auto px-8 max-sm:px-4 flex flex-row justify-center gap-6"
  >
    <div class="w-64 max-xl:hidden"></div>
    <article
      class="flex flex-col gap-8 max-w-3xl max-md:w-full pb-10 pt-8 mt-8 px-14 max-md:px-10 max-sm:px-4  dark:bg-transparent bg-white dark:border-0 border border-neutral-100 rounded-2xl" 
    >
      <header class="flex flex-col gap-4" id="start">
        <div class="flex gap-2 flex-wrap">
          {
            frontmatter.languages.map((language: string) => (
              <Capsule lang={language} />
            ))
          }
        </div>
        
        {frontmatter.category && (
          <span class="w-fit rounded-full bg-mint-50 px-3 py-1 text-sm font-bold text-mint-700 dark:bg-mint-950 dark:text-mint-200">
            {frontmatter.category}
          </span>
        )}

        <Heading text={frontmatter.title} />

        {frontmatter.url && (
          <a
            href={frontmatter.url}
            target="_blank"
            rel="noopener noreferrer"
            class="w-fit rounded-full bg-mint-500 px-5 py-2 font-bold text-white transition-all hover:bg-mint-600"
          >
            Visitar sitio ↗
          </a>
        )}
      </header>

      <figure>
        {
          frontmatter.image?.url && (
            <img
              class="w-full rounded-xl"
              src={frontmatter.image.url}
              alt={frontmatter.image.alt || "Imagen del proyecto"}
            />
          )
        }
      </figure>

      <div class="markdown " id="content">
        <slot />
      </div>
      
    </article>
    <NavArticle title={frontmatter.title} />
  </section>
  <div
    class="flex flex-col gap-6 max-w-4xl max-lg:py-2 py-3 max-xl:py-2 mx-auto"
  >
  

  </div>
</Layout>
